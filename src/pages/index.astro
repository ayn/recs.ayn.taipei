---
import { categories, mapsUrl, recs, routes, sections } from "../data/recs";

const description =
  "A short personal Taipei starter guide for first-time visitors.";

const splitName = (name: string) => {
  const parts = name.split(" / ");
  return {
    primary: parts[0],
    secondary: parts.length > 1 ? parts.slice(1).join(" / ") : "",
  };
};

const isMapsLink = (href: string) =>
  href.includes("maps.app.goo.gl") || href.includes("google.com/maps");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Taipei Recs</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://recs.ayn.taipei" />
    <meta property="og:title" content="Taipei Recs" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://recs.ayn.taipei" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f1e7;
        --paper: #fffaf1;
        --ink: #25211c;
        --muted: #746a5d;
        --line: #dfd1bd;
        --accent: #b24b2e;
        --accent-soft: #ead5c9;
        --green: #5a7658;
        --shadow: 0 14px 45px rgba(72, 48, 23, 0.09);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          linear-gradient(90deg, rgba(37, 33, 28, 0.035) 1px, transparent 1px) 0 0 / 28px 28px,
          var(--bg);
        color: var(--ink);
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
        line-height: 1.5;
      }

      a {
        color: inherit;
      }

      .page {
        width: min(100%, 1120px);
        margin: 0 auto;
        padding: 22px 16px 42px;
      }

      .hero {
        padding: 42px 0 28px;
        border-bottom: 1px solid var(--line);
      }

      .eyebrow {
        margin: 0 0 18px;
        color: var(--accent);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 720px;
        margin-bottom: 16px;
        font-size: clamp(3.1rem, 15vw, 7.4rem);
        line-height: 0.9;
        letter-spacing: 0;
      }

      .intro {
        max-width: 680px;
        color: var(--muted);
        font-size: clamp(1.05rem, 2.5vw, 1.28rem);
      }

      .quick-routes {
        display: grid;
        gap: 12px;
        margin: 24px 0 0;
      }

      .route {
        padding: 16px;
        border: 1px solid var(--line);
        background: rgba(255, 250, 241, 0.74);
        box-shadow: var(--shadow);
      }

      .route h2 {
        margin-bottom: 4px;
        font-size: 1rem;
      }

      .route p {
        margin-bottom: 8px;
        color: var(--muted);
      }

      .route .stops {
        color: var(--green);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
      }

      .filters {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        gap: 8px;
        margin: 0 -16px 28px;
        padding: 12px 16px;
        overflow-x: auto;
        background: rgba(247, 241, 231, 0.92);
        border-bottom: 1px solid rgba(223, 209, 189, 0.7);
        backdrop-filter: blur(14px);
      }

      .filters,
      .section {
        scroll-margin-top: 76px;
      }

      .filter {
        flex: 0 0 auto;
        display: inline-flex;
        min-height: 38px;
        align-items: center;
        padding: 9px 13px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        color: var(--muted);
        font: 700 0.86rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        text-decoration: none;
      }

      .filter[aria-current="true"] {
        border-color: var(--accent);
        background: var(--accent);
        color: #fffaf1;
      }

      .section {
        padding: 32px 0;
        border-bottom: 1px solid var(--line);
      }

      .section-head {
        display: grid;
        gap: 6px;
        margin-bottom: 16px;
      }

      .section h2 {
        max-width: 12.5ch;
        font-size: clamp(2.15rem, 9vw, 3.2rem);
        line-height: 1;
        letter-spacing: 0;
        overflow-wrap: normal;
        text-wrap: balance;
      }

      .section-dek {
        color: var(--muted);
        font-size: 1rem;
      }

      .section-link {
        display: inline-flex;
        width: fit-content;
        min-height: 34px;
        align-items: center;
        gap: 7px;
        padding: 8px 11px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        color: var(--accent);
        font: 800 0.82rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        text-decoration: none;
      }

      .section-link svg {
        flex: 0 0 auto;
        width: 16px;
        height: 16px;
      }

      .rec-list {
        display: grid;
        gap: 10px;
      }

      .rec {
        display: grid;
        gap: 12px;
        padding: 16px;
        border: 1px solid var(--line);
        background: rgba(255, 250, 241, 0.82);
      }

      .rec-photo {
        aspect-ratio: 4 / 3;
        width: 100%;
        overflow: hidden;
        border: 1px solid var(--line);
        background: var(--accent-soft);
      }

      .rec-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .rec h3 {
        margin-bottom: 4px;
        font-size: 1.25rem;
        line-height: 1.15;
      }

      .name-primary,
      .name-secondary {
        display: block;
      }

      .name-secondary {
        margin-top: 3px;
        color: var(--muted);
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.25;
      }

      .area {
        color: var(--accent);
        font: 700 0.82rem/1.3 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .note {
        margin-bottom: 0;
        color: var(--muted);
      }

      .tip {
        margin: 0;
        padding: 10px 12px;
        border-left: 3px solid var(--green);
        background: rgba(90, 118, 88, 0.09);
        color: #4d5f48;
        font-size: 0.95rem;
      }

      .tip strong {
        color: var(--green);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.74rem;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .getting-there {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 10px;
        align-items: center;
        margin: 0;
        padding: 10px 12px;
        border: 1px solid rgba(223, 209, 189, 0.78);
        background: rgba(255, 250, 241, 0.72);
        color: var(--muted);
        font-size: 0.95rem;
      }

      .transit-pill {
        display: inline-flex;
        min-height: 26px;
        align-items: center;
        padding: 5px 9px;
        border-radius: 999px;
        background: #efe5d8;
        color: var(--ink);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      .transit-pill[data-tone="red"] {
        background: #c7372f;
        color: #fffaf1;
      }

      .transit-pill[data-tone="green"] {
        background: #27815f;
        color: #fffaf1;
      }

      .transit-pill[data-tone="blue"] {
        background: #266fb7;
        color: #fffaf1;
      }

      .transit-pill[data-tone="brown"] {
        background: #9a6a3a;
        color: #fffaf1;
      }

      .transit-pill[data-tone="orange"] {
        background: #f08b22;
        color: #25211c;
      }

      .transit-pill[data-tone="mixed"] {
        background: #25211c;
        color: #fffaf1;
      }

      .transit-pill[data-tone="train"] {
        background: #5a7658;
        color: #fffaf1;
      }

      .transit-pill[data-tone="car"] {
        background: var(--accent);
        color: #fffaf1;
      }

      .transit-detail {
        flex: 1 1 190px;
      }

      .rec-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
      }

      .map {
        display: inline-flex;
        min-height: 36px;
        align-items: center;
        padding: 8px 12px;
        border: 1px solid var(--ink);
        border-radius: 999px;
        font: 800 0.84rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        text-decoration: none;
      }

      .tag {
        display: inline-flex;
        min-height: 28px;
        align-items: center;
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: #673c2e;
        font: 700 0.74rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .hidden {
        display: none;
      }

      footer {
        padding: 28px 0 4px;
        color: var(--muted);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.9rem;
      }

      @media (min-width: 760px) {
        .page {
          padding: 34px 28px 56px;
        }

        .hero {
          padding-top: 72px;
        }

        .quick-routes {
          grid-template-columns: repeat(3, 1fr);
        }

        .filters {
          margin-right: -28px;
          margin-left: -28px;
          padding-right: 28px;
          padding-left: 28px;
        }
      }

      @media (min-width: 980px) {
        .section {
          display: grid;
          grid-template-columns: 390px minmax(0, 1fr);
          gap: 44px;
        }

        .section h2 {
          font-size: clamp(2.9rem, 4vw, 3.35rem);
        }

        .section-head {
          align-content: start;
          position: sticky;
          top: 76px;
        }

        .rec {
          grid-template-columns: minmax(210px, 0.78fr) minmax(0, 1.22fr);
          padding: 18px;
        }

        .note,
        .tip,
        .getting-there {
          grid-column: 2;
        }

        .rec-bottom {
          grid-column: 2;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="hero">
        <p class="eyebrow">Andrew's Taipei starter guide</p>
        <h1>Taipei Recs</h1>
        <p class="intro">
          A few places I usually recommend to friends visiting Taipei for the first time.
          Mostly food, neighborhoods, easy walks, and a couple classic tourist things that
          are still worth doing.
        </p>

        <div class="quick-routes" aria-label="Suggested routes">
          {routes.map((route) => (
            <article class="route">
              <h2>{route.title}</h2>
              <p>{route.note}</p>
              <div class="stops">{route.stops}</div>
            </article>
          ))}
        </div>
      </header>

      <nav class="filters" id="recs" aria-label="Recommendation filters">
        {categories.map((category) => (
          <a
            class="filter"
            href={category.id === "all" ? "#recs" : `#${category.id}`}
            data-filter={category.id}
            aria-current={category.id === "all" ? "true" : undefined}
          >
            {category.label}
          </a>
        ))}
      </nav>

      {sections.map((section) => (
        <section class="section" id={section.id} data-section={section.id}>
          <div class="section-head">
            <h2>{section.title}</h2>
            {section.dek && <p class="section-dek">{section.dek}</p>}
            {section.link && (
              <a class="section-link" href={section.link.href} target="_blank" rel="noreferrer">
                {isMapsLink(section.link.href) && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#34a853" d="M12 2.2a7.8 7.8 0 0 0-7.8 7.8c0 5.8 7.8 11.8 7.8 11.8s7.8-6 7.8-11.8A7.8 7.8 0 0 0 12 2.2Z" />
                    <path fill="#4285f4" d="M12 2.2v7.8l5.5 5.5c1.4-1.9 2.3-3.8 2.3-5.5A7.8 7.8 0 0 0 12 2.2Z" />
                    <path fill="#fbbc04" d="M12 10 6.5 15.5c1.9 2.7 5.5 6.3 5.5 6.3s3.6-3.6 5.5-6.3L12 10Z" />
                    <circle cx="12" cy="10" r="3.1" fill="#fffaf1" />
                    <circle cx="12" cy="10" r="1.7" fill="#ea4335" />
                  </svg>
                )}
                <span>{section.link.label}</span>
              </a>
            )}
          </div>
          <div class="rec-list">
            {recs
              .filter((rec) => rec.category === section.id)
              .map((rec) => {
                const displayName = splitName(rec.name);

                return (
                  <article class="rec" data-category={rec.category}>
                    {rec.image && (
                      <figure class="rec-photo">
                        <img src={rec.image.src} alt={rec.image.alt} loading="lazy" />
                      </figure>
                    )}
                    <div>
                      <div class="area">{rec.area}</div>
                      <h3>
                        <span class="name-primary">{displayName.primary}</span>
                        {displayName.secondary && <span class="name-secondary">{displayName.secondary}</span>}
                      </h3>
                    </div>
                    <p class="note">{rec.note}</p>
                    {rec.tip && (
                      <p class="tip">
                        <strong>Tip</strong> {rec.tip}
                      </p>
                    )}
                    {rec.gettingThere && (
                      <p class="getting-there">
                        {rec.gettingThere.pills.map((pill) => (
                          <span class="transit-pill" data-tone={pill.tone}>{pill.label}</span>
                        ))}
                        <span class="transit-detail">{rec.gettingThere.detail}</span>
                      </p>
                    )}
                    <div class="rec-bottom">
                      <a class="map" href={rec.mapUrl ?? mapsUrl(rec.mapQuery)} target="_blank" rel="noreferrer">
                        Map
                      </a>
                      {rec.tags.map((tag) => <span class="tag">{tag}</span>)}
                    </div>
                  </article>
                );
              })}
          </div>
        </section>
      ))}

      <footer>Made for friends visiting Taipei.</footer>
    </main>

    <script>
      const links = Array.from(document.querySelectorAll(".filter"));
      const sections = Array.from(document.querySelectorAll("[data-section]"));
      const filters = new Set(links.map((link) => link.dataset.filter));

      function applyFilter(filter) {
        links.forEach((link) => {
          if (link.dataset.filter === filter) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        });

        sections.forEach((section) => {
          const showSection = filter === "all" || section.dataset.section === filter;
          section.classList.toggle("hidden", !showSection);
        });
      }

      function currentFilter() {
        const hash = window.location.hash.replace("#", "");
        return filters.has(hash) ? hash : "all";
      }

      function scrollToFilter(filter) {
        const target =
          filter === "all"
            ? document.querySelector("#recs")
            : document.querySelector(`[data-section="${CSS.escape(filter)}"]`);

        target?.scrollIntoView({ block: "start" });
      }

      links.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();

          const filter = link.dataset.filter || "all";
          history.pushState(null, "", link.getAttribute("href"));
          applyFilter(filter);
          requestAnimationFrame(() => scrollToFilter(filter));
        });
      });

      window.addEventListener("popstate", () => {
        const filter = currentFilter();
        applyFilter(filter);
        requestAnimationFrame(() => scrollToFilter(filter));
      });

      applyFilter(currentFilter());
    </script>
  </body>
</html>
