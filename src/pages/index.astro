---
import { categories, mapsUrl, recs, routes, sections } from "../data/recs";

const description =
  "A short personal Taipei starter guide for first-time visitors.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Taipei Recs</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://recs.ayn.taipei" />
    <meta property="og:title" content="Taipei Recs" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://recs.ayn.taipei" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f1e7;
        --paper: #fffaf1;
        --ink: #25211c;
        --muted: #746a5d;
        --line: #dfd1bd;
        --accent: #b24b2e;
        --accent-soft: #ead5c9;
        --green: #5a7658;
        --shadow: 0 14px 45px rgba(72, 48, 23, 0.09);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          linear-gradient(90deg, rgba(37, 33, 28, 0.035) 1px, transparent 1px) 0 0 / 28px 28px,
          var(--bg);
        color: var(--ink);
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", serif;
        line-height: 1.5;
      }

      a {
        color: inherit;
      }

      .page {
        width: min(100%, 1040px);
        margin: 0 auto;
        padding: 22px 16px 42px;
      }

      .hero {
        padding: 42px 0 28px;
        border-bottom: 1px solid var(--line);
      }

      .eyebrow {
        margin: 0 0 18px;
        color: var(--accent);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 720px;
        margin-bottom: 16px;
        font-size: clamp(3.1rem, 15vw, 7.4rem);
        line-height: 0.9;
        letter-spacing: 0;
      }

      .intro {
        max-width: 680px;
        color: var(--muted);
        font-size: clamp(1.05rem, 2.5vw, 1.28rem);
      }

      .quick-routes {
        display: grid;
        gap: 12px;
        margin: 24px 0 0;
      }

      .route {
        padding: 16px;
        border: 1px solid var(--line);
        background: rgba(255, 250, 241, 0.74);
        box-shadow: var(--shadow);
      }

      .route h2 {
        margin-bottom: 4px;
        font-size: 1rem;
      }

      .route p {
        margin-bottom: 8px;
        color: var(--muted);
      }

      .route .stops {
        color: var(--green);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
      }

      .filters {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        gap: 8px;
        margin: 0 -16px 28px;
        padding: 12px 16px;
        overflow-x: auto;
        background: rgba(247, 241, 231, 0.92);
        border-bottom: 1px solid rgba(223, 209, 189, 0.7);
        backdrop-filter: blur(14px);
      }

      .filter {
        flex: 0 0 auto;
        min-height: 38px;
        padding: 9px 13px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
        color: var(--muted);
        font: 700 0.86rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        cursor: pointer;
      }

      .filter[aria-pressed="true"] {
        border-color: var(--accent);
        background: var(--accent);
        color: #fffaf1;
      }

      .section {
        padding: 32px 0;
        border-bottom: 1px solid var(--line);
      }

      .section-head {
        display: grid;
        gap: 6px;
        margin-bottom: 16px;
      }

      .section h2 {
        font-size: clamp(1.75rem, 7vw, 3rem);
        line-height: 1;
        letter-spacing: 0;
      }

      .section-dek {
        color: var(--muted);
        font-size: 1rem;
      }

      .rec-list {
        display: grid;
        gap: 10px;
      }

      .rec {
        display: grid;
        gap: 12px;
        padding: 16px;
        border: 1px solid var(--line);
        background: rgba(255, 250, 241, 0.82);
      }

      .rec h3 {
        margin-bottom: 4px;
        font-size: 1.25rem;
        line-height: 1.15;
      }

      .area {
        color: var(--accent);
        font: 700 0.82rem/1.3 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .note {
        margin-bottom: 0;
        color: var(--muted);
      }

      .rec-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
      }

      .map {
        display: inline-flex;
        min-height: 36px;
        align-items: center;
        padding: 8px 12px;
        border: 1px solid var(--ink);
        border-radius: 999px;
        font: 800 0.84rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        text-decoration: none;
      }

      .tag {
        display: inline-flex;
        min-height: 28px;
        align-items: center;
        padding: 5px 9px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: #673c2e;
        font: 700 0.74rem/1 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .hidden {
        display: none;
      }

      footer {
        padding: 28px 0 4px;
        color: var(--muted);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 0.9rem;
      }

      @media (min-width: 760px) {
        .page {
          padding: 34px 28px 56px;
        }

        .hero {
          padding-top: 72px;
        }

        .quick-routes {
          grid-template-columns: repeat(3, 1fr);
        }

        .filters {
          margin-right: -28px;
          margin-left: -28px;
          padding-right: 28px;
          padding-left: 28px;
        }

        .section {
          grid-template-columns: 260px 1fr;
          display: grid;
          gap: 34px;
        }

        .section-head {
          align-content: start;
          position: sticky;
          top: 76px;
        }

        .rec {
          grid-template-columns: minmax(190px, 0.8fr) 1.2fr;
          padding: 18px;
        }

        .rec-bottom {
          grid-column: 2;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="hero">
        <p class="eyebrow">Andrew's Taipei starter guide</p>
        <h1>Taipei Recs</h1>
        <p class="intro">
          A few places I usually recommend to friends visiting Taipei for the first time.
          Mostly food, neighborhoods, easy walks, and a couple classic tourist things that
          are still worth doing.
        </p>

        <div class="quick-routes" aria-label="Suggested routes">
          {routes.map((route) => (
            <article class="route">
              <h2>{route.title}</h2>
              <p>{route.note}</p>
              <div class="stops">{route.stops}</div>
            </article>
          ))}
        </div>
      </header>

      <nav class="filters" aria-label="Recommendation filters">
        {categories.map((category) => (
          <button
            class="filter"
            type="button"
            data-filter={category.id}
            aria-pressed={category.id === "all" ? "true" : "false"}
          >
            {category.label}
          </button>
        ))}
      </nav>

      {sections.map((section) => (
        <section class="section" data-section={section.id}>
          <div class="section-head">
            <h2>{section.title}</h2>
            {section.dek && <p class="section-dek">{section.dek}</p>}
          </div>
          <div class="rec-list">
            {recs
              .filter((rec) => rec.category === section.id)
              .map((rec) => (
                <article class="rec" data-category={rec.category}>
                  <div>
                    <div class="area">{rec.area}</div>
                    <h3>{rec.name}</h3>
                  </div>
                  <p class="note">{rec.note}</p>
                  <div class="rec-bottom">
                    <a class="map" href={mapsUrl(rec.mapQuery)} target="_blank" rel="noreferrer">
                      Map
                    </a>
                    {rec.tags.map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                </article>
              ))}
          </div>
        </section>
      ))}

      <footer>Made for friends visiting Taipei.</footer>
    </main>

    <script>
      const buttons = Array.from(document.querySelectorAll(".filter"));
      const sections = Array.from(document.querySelectorAll("[data-section]"));

      function applyFilter(filter) {
        buttons.forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.filter === filter));
        });

        sections.forEach((section) => {
          const showSection = filter === "all" || section.dataset.section === filter;
          section.classList.toggle("hidden", !showSection);
        });
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => applyFilter(button.dataset.filter || "all"));
      });
    </script>
  </body>
</html>
